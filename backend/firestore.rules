rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.roles != null && 'admin' in request.auth.token.roles) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isDriver() {
      return isAuthenticated() && (
        request.auth.token.role == 'driver' ||
        (request.auth.token.roles != null && 'driver' in request.auth.token.roles) ||
        exists(/databases/$(database)/documents/drivers/$(request.auth.uid))
      );
    }

    // ===============================================================
    // 1. users/{uid}
    // ===============================================================
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ===============================================================
    // 2. driverApplications/{uid}
    // ===============================================================
    match /driverApplications/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ===============================================================
    // 3. drivers/{uid} (and driverProfiles/{uid} legacy alias)
    // ===============================================================
    match /drivers/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /driverProfiles/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ===============================================================
    // 4. vehicles/{vehicleId}
    // ===============================================================
    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.driverId == request.auth.uid || isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.driverId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ===============================================================
    // 5. bookings/{bookingId}
    // ===============================================================
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.driverId == null ||
        resource.data.bookingStatus == 'searching' ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        request.resource.data.driverId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ===============================================================
    // 6. driverJobOffers/{offerId}
    // ===============================================================
    match /driverJobOffers/{offerId} {
      allow read: if isAuthenticated() && (
        resource.data.driverId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.driverId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /dispatchRequests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    // ===============================================================
    // 7. trips/{tripId}
    // ===============================================================
    match /trips/{tripId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.driverId == request.auth.uid || isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.driverId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ===============================================================
    // 8. payments/{paymentId}
    // ===============================================================
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid || isAdmin()
      );
      allow write: if isAdmin();
    }

    // ===============================================================
    // 9. driverEarnings/{earningId}
    // ===============================================================
    match /driverEarnings/{earningId} {
      allow read: if isAuthenticated() && (
        resource.data.driverId == request.auth.uid || isAdmin()
      );
      allow write: if isAdmin();
    }

    // ===============================================================
    // 10. savedAddresses/{addressId}
    // ===============================================================
    match /savedAddresses/{addressId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ===============================================================
    // 11. notifications/{notificationId}
    // ===============================================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
    }

    match /deviceTokens/{tokenId} {
      allow read, write: if isAuthenticated();
    }

    // ===============================================================
    // 12. reviews/{reviewId}
    // ===============================================================
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ===============================================================
    // 13. supportTickets/{ticketId}
    // ===============================================================
    match /supportTickets/{ticketId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ===============================================================
    // 14. pricingConfig/{configId}
    // ===============================================================
    match /pricingConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /pricingConfigs/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ===============================================================
    // 15. adminAuditLogs/{logId}
    // ===============================================================
    match /adminAuditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
